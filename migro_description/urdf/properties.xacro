<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- Robot Properties -->
  <!-- ========================================================= -->

  <!-- Chassis -->
  <xacro:property name="chassis_length" value="0.5"/>
  <xacro:property name="chassis_width" value="0.4"/>
  <xacro:property name="chassis_height" value="0.2"/>

  <!-- Wheels -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.06"/>

  <xacro:property name="wheel_x" value="0.18"/>
  <xacro:property name="wheel_y" value="0.24"/>
  <xacro:property name="wheel_z" value="${wheel_radius}"/>

  <!-- Ground Clearance -->
  <xacro:property name="ground_clearance" value="0.05"/>

  <!-- Body Height -->
  <xacro:property
      name="body_z"
      value="${wheel_radius + ground_clearance + chassis_height/2}"/>

  <!-- Camera -->
  <xacro:property name="camera_length" value="0.08"/>
  <xacro:property name="camera_width" value="0.08"/>
  <xacro:property name="camera_height" value="0.05"/>

  <xacro:property name="camera_x" value="0.0"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property
      name="camera_z"
      value="${body_z + chassis_height/2 - 0.05}"/>

</robot>