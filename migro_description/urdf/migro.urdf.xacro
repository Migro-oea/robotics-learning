<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="migro">

  <!-- ========================================================= -->
  <!-- Robot Properties -->
  <!-- ========================================================= -->

  <!-- Chassis -->
  <xacro:property name="chassis_length" value="0.5"/>
  <xacro:property name="chassis_width" value="0.4"/>
  <xacro:property name="chassis_height" value="0.2"/>

  <!-- Wheels -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.06"/>

  <xacro:property name="wheel_x" value="0.18"/>
  <xacro:property name="wheel_y" value="0.24"/>
  <xacro:property name="wheel_z" value="${wheel_radius}"/>

  <!-- Ground Clearance -->
  <xacro:property name="ground_clearance" value="0.05"/>

  <!-- Height of chassis above the world -->
  <xacro:property
      name="body_z"
      value="${wheel_radius + ground_clearance + chassis_height/2}"/>

  <!-- Camera -->
  <xacro:property name="camera_length" value="0.08"/>
  <xacro:property name="camera_width" value="0.08"/>
  <xacro:property name="camera_height" value="0.05"/>

  <xacro:property name="camera_x" value="0.0"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property
      name="camera_z"
      value="${body_z + chassis_height/2 - 0.05}"/>

  <!-- ========================================================= -->
  <!-- Materials -->
  <!-- ========================================================= -->

  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <!-- ========================================================= -->
  <!-- Chassis -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>

      <origin xyz="0 0 ${body_z}"/>

      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>

      <material name="blue"/>

    </visual>

    <collision>

      <origin xyz="0 0 ${body_z}"/>

      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>

    </collision>

  </link>

  <!-- ========================================================= -->
  <!-- Camera -->
  <!-- ========================================================= -->

  <link name="camera_link">

    <visual>

      <origin xyz="0 0 ${camera_height/2}"/>

      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>

      <material name="black"/>

    </visual>

    <collision>

      <origin xyz="0 0 ${camera_height/2}"/>

      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>

    </collision>

  </link>

  <joint name="camera_joint" type="fixed">

    <parent link="base_link"/>

    <child link="camera_link"/>

    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>

  </joint>

  <!-- ========================================================= -->
  <!-- Wheel Macro -->
  <!-- ========================================================= -->

  <xacro:macro name="wheel" params="name x y z">

    <link name="${name}">

      <visual>

        <origin xyz="0 0 0"/>

        <geometry>
          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>
        </geometry>

        <material name="grey"/>

      </visual>

      <collision>

        <origin xyz="0 0 0"/>

        <geometry>
          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>
        </geometry>

      </collision>

    </link>

    <joint
        name="${name}_joint"
        type="fixed">

      <parent link="base_link"/>

      <child link="${name}"/>

      <origin
          xyz="${x} ${y} ${z}"
          rpy="1.5708 0 0"/>

    </joint>

  </xacro:macro>

  <!-- ========================================================= -->
  <!-- Wheels -->
  <!-- ========================================================= -->

  <xacro:wheel
      name="left_front_wheel"
      x="${wheel_x}"
      y="${wheel_y}"
      z="${wheel_z}"/>

  <xacro:wheel
      name="right_front_wheel"
      x="${wheel_x}"
      y="${-wheel_y}"
      z="${wheel_z}"/>

  <xacro:wheel
      name="left_rear_wheel"
      x="${-wheel_x}"
      y="${wheel_y}"
      z="${wheel_z}"/>

  <xacro:wheel
      name="right_rear_wheel"
      x="${-wheel_x}"
      y="${-wheel_y}"
      z="${wheel_z}"/>

</robot>