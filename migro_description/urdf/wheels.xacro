<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- Wheel Instances -->
  <!-- ========================================================= -->

  <xacro:wheel
      name="left_front_wheel"
      x="${wheel_x}"
      y="${wheel_y}"
      z="${wheel_z}"/>

  <xacro:wheel
      name="right_front_wheel"
      x="${wheel_x}"
      y="${-wheel_y}"
      z="${wheel_z}"/>

  <xacro:wheel
      name="left_rear_wheel"
      x="${-wheel_x}"
      y="${wheel_y}"
      z="${wheel_z}"/>

  <xacro:wheel
      name="right_rear_wheel"
      x="${-wheel_x}"
      y="${-wheel_y}"
      z="${wheel_z}"/>

</robot>