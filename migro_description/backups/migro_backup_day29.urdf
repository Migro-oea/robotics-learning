<?xml version="1.0"?>

<robot name="migro">

  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <box size="0.5 0.4 0.2"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <box size="0.08 0.08 0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

</robot>